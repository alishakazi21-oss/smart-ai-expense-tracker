# == SpendWise Project .gitignore =============================

# -- Python virtual environment & caches
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# -- Node.js dependencies & builds
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache

# -- Local configuration & keys
.env
.env.local
.env.*.local
*.env
gcp-key.json

# -- Local SQLite databases (strictly isolate student transactions)
backend/*.db
backend/*.db-journal
backend/*.db-wal
*.db
*.db-journal
*.db-wal

# -- System & IDE files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
